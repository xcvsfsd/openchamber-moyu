{
  "name": "openchamber-moyu",
  "version": "0.14.7",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "摸鱼阅读：V2EX / linux.do / 知乎 / 头条 / CSDN / 开源中国 / InfoQ（tophub 聚合 + 官网直出）",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.2"
    },
    "contributes": {
      "panel": {
        "id": "moyu-reader",
        "name": "阅读",
        "icon": "assets/icon.svg",
        "entry": "panel/index.html"
      },
      "origins": [
        "https://linux.do",
        "https://cdn.ldstatic.com",
        "https://www.v2ex.com",
        "https://cdn.v2ex.com",
        "https://www.infoq.cn",
        "https://static001.infoq.cn",
        "https://static001.geekbang.org"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "capabilities": [
        "model"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "dompurify": "3.4.18"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.2",
    "@types/bun": "latest",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.2"
  }
}
