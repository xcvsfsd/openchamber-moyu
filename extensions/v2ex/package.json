{
  "name": "openchamber-moyu-v2ex",
  "version": "0.1.0",
  "description": "V2EX 摸鱼阅读：话题=会话的假聊天页（匿名可读）",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.2"
    },
    "contributes": {
      "panel": {
        "id": "moyu-v2ex",
        "name": "阅读 V",
        "icon": "assets/v.svg",
        "entry": "panel/index.html"
      },
      "origins": [
        "https://linux.do",
        "https://cdn.ldstatic.com",
        "https://www.v2ex.com",
        "https://cdn.v2ex.com"
      ],
      "capabilities": [
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
